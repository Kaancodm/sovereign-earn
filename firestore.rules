rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.coinBalance == 0;
      allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.coinBalance == resource.data.coinBalance;
      allow delete: if false;
    }
    match /coachingRequests/{id} {
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || resource.data.senseiId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.priceCoins is number && request.resource.data.priceCoins > 0 && request.resource.data.escrowCoins == 0;
      allow update, delete: if false;
    }
    match /ledger/{id} { allow read, write: if false; }
    match /payouts/{id} { allow read, write: if false; }
    match /postbacks/{id} { allow read, write: if false; }
  }
}
